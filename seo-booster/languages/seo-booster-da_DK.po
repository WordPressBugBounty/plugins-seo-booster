msgstr ""
"Indholdet er under 600 ord (%d registreret). Sigt højere for AI-"
"svarsynlighed."

#: inc/Analysis/Checks/Content_Checks.php:88
msgid "The content is quite long. Consider breaking it into multiple sections."
msgstr "Indholdet er ret langt. Overvej at opdele det i flere afsnit."

#: inc/Analysis/Checks/Content_Checks.php:92
msgid "The content has a good length."
msgstr "Indholdet har en god længde."

#: inc/Analysis/Checks/Content_Checks.php:112
msgid "Featured image is missing. Set a featured image for richer previews."
msgstr ""
"Udvalgt billede mangler. Indstil et udvalgt billede for at få mere "
"omfattende forhåndsvisninger."

#: inc/Analysis/Checks/Content_Checks.php:120
msgid "Featured image is set."
msgstr "Udvalgt billede er indstillet."

#: inc/Analysis/Checks/Content_Checks.php:142
msgid ""
"No question-style heading (FAQ) found. Consider adding H2/H3 headings that "
"end with a question mark."
msgstr ""
"Der blev ikke fundet nogen overskrift i stil med spørgsmål (FAQ). Overvej at "
"tilføje H2/H3-overskrifter, der slutter med et spørgsmålstegn."

#: inc/Analysis/Checks/Content_Checks.php:150
msgid "Question-style heading (FAQ) found."
msgstr "Spørgsmålslignende overskrift (FAQ) fundet."

