#, php-format
msgid "Found %d H2 heading(s) for good content structure."
msgstr "Fundet %d H2-overskrifter for god indholdsstruktur."

#: inc/Analysis/Checks/Content_Checks.php:217
msgid "The focus keyword density is too low. Consider using it more often."
msgstr "Fokussøgeordets tæthed er for lav. Overvej at bruge det oftere."

#: inc/Analysis/Checks/Content_Checks.php:219
msgid "The focus keyword density is too high. Consider reducing it."
msgstr "Fokussøgeordets tæthed er for høj. Overvej at reducere den."

#: inc/Analysis/Checks/Content_Checks.php:221
msgid "The focus keyword density is good."
msgstr "Fokussøgeordets tæthed er god."

#: inc/Analysis/Checks/Content_Checks.php:234
msgid "Content is very thin. Expand the page to avoid thin-content signals."
msgstr ""
"Indholdet er meget tyndt. Udvid siden for at undgå signaler med tyndt "
"indhold."

#: inc/Analysis/Checks/Content_Checks.php:238
msgid "Content appears to be substantial."
msgstr "Indholdet ser ud til at være væsentligt."

#: inc/Analysis/Checks/Content_Checks.php:271
msgid ""
"No contact information found. Consider adding contact details to improve "
"trustworthiness and E-E-A-T."
msgstr ""
"Der blev ikke fundet kontaktoplysninger. Overvej at tilføje "
"kontaktoplysninger for at forbedre troværdigheden og E-E-A-T."

#: inc/Analysis/Checks/Content_Checks.php:275
#, php-format
msgid "Found contact information (%d type(s))."
msgstr "Fundet kontaktinformation (%d type(r))."

