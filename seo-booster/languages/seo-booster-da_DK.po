msgid "Consider using shorter sentences for better readability."
msgstr "Overvej at bruge kortere sætninger for at forbedre læsbarheden."

#: inc/Analysis/Checks/Content_Checks.php:304
msgid "Good sentence length for readability."
msgstr "God sætningslængde for læsbarhed."

#: inc/Analysis/Checks/Content_Checks.php:329
msgid "Good sentence length. Easy to read."
msgstr "God sætningslængde. Let at læse."

#: inc/Analysis/Checks/Content_Checks.php:331
msgid "Consider shortening some sentences for better readability."
msgstr "Overvej at forkorte nogle sætninger for at forbedre læsbarheden."

#: inc/Analysis/Checks/Content_Checks.php:333
msgid ""
"Some sentences are quite long. Consider breaking them up for better "
"readability."
