<?xml version="1.0"?>
<ruleset name="SEO Booster">
	<description>WordPress Coding Standards for SEO Booster plugin.</description>

	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<!-- Plugin-local credits Node app only; do not use */app/* (matches Local Sites .../app/public/...). -->
	<exclude-pattern>*/plugins/seo-booster/app/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/js/*</exclude-pattern>
	<exclude-pattern>*/css/*</exclude-pattern>
	<exclude-pattern>languages/*.l10n.php</exclude-pattern>

	<rule ref="WordPress-Extra"/>

	<config name="testVersion" value="7.4-"/>
	<ini name="memory_limit" value="512M"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="seo-booster"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="seobooster"/>
				<element value="seo_booster"/>
				<element value="sb2"/>
				<element value="sb_"/>
			</property>
		</properties>
	</rule>
</ruleset>
